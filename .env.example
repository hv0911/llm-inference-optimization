# =============================================================================
# Production LLM Optimization — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your values.
#   cp .env.example .env
#
# NEVER commit the `.env` file to version control.
# =============================================================================

# HuggingFace Hub credentials (for model download/upload)
HF_TOKEN=hf_your_token_here
HF_USERNAME=YOUR_HF_USERNAME

# Model configuration
MODEL_ID=Qwen/Qwen3-0.6B
BASE_MODEL_DIR=models/base
AWQ_MODEL_DIR=models/awq
GPTQ_MODEL_DIR=models/gptq

# vLLM serving
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=2048

# Results
RESULTS_DIR=results
